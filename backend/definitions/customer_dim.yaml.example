# Example: rename to customer_dim.yaml once a `sap_prod` and `fabric_dw`
# connection have been created via the Connections UI.

pipeline:
  name: load_dim_customer
  description: Load customer dimension from SAP into Fabric Warehouse
  mode: incremental
  schedule: "0 */4 * * *"
  enabled: true
  source:
    connection: sap_prod
    object: BusinessPartner
    incremental_field: LastChangeDateTime
  destination:
    connection: fabric_dw
    object: dim_customer
  field_mappings:
    - source: BusinessPartner
      destination: customer_key
    - source: BusinessPartnerFullName
      destination: customer_name
      transform: trim
    - source: Country
      destination: country_code
      transform: upper
  # Optional in-flight transformation plan, applied to each batch after the
  # field mappings and before the write. Steps run top-to-bottom. The same
  # steps are editable through the drag-and-drop builder in the pipeline UI.
  transform:
    on_error: skip        # skip = drop+log bad rows; fail = abort the run
    steps:
      - type: cast
        config: {column: customer_key, to: string}
      - type: fill_null
        config: {column: country_code, value: "ZZ"}
      - type: set_constant
        config: {column: source_system, value: SAP}
      - type: python_column
        config:
          column: customer_name
          # `value` is the current cell, `row` is the whole record
          code: "(value or '').strip().title()"
      - type: filter
        config:
          code: "bool((row.get('customer_key') or '').strip())"

assets:
  - key: dim_customer
    description: Customer dimension (current state)
    metadata:
      owner: data-platform
      tier: silver
    freshness:
      max_age_minutes: 240   # auto-re-materialise if older than 4 hours

---
# A downstream pipeline can be defined in another file and reference this
# asset under depends_on:
#
#   pipeline:
#     name: build_customer_segments
#     ...
#   assets:
#     - key: customer_segments
#       depends_on: [dim_customer, fact_orders]
