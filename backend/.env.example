DIP_APP_NAME="Data Integration Platform"
DIP_ENVIRONMENT=development
DIP_SECRET_KEY=replace-with-a-real-secret
DIP_LOG_LEVEL=INFO

# SurrealDB is the platform's metadata store. Point these at your
# dedicated SurrealDB instance — the docker-compose service is fine
# for local development.
DIP_SURREALDB_URL=ws://surrealdb:8000/rpc
DIP_SURREALDB_USER=root
DIP_SURREALDB_PASSWORD=root
DIP_SURREALDB_NAMESPACE=dip
DIP_SURREALDB_DATABASE=dip

DIP_SCHEDULER_ENABLED=true
DIP_FRESHNESS_CHECK_INTERVAL_SECONDS=60
DIP_DEFINITIONS_DIR=definitions
DIP_AUTOLOAD_DEFINITIONS=true
